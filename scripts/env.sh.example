# Copy to env.sh and edit. env.sh is gitignored.
# shellcheck shell=bash

# Where everything lands. On the DGX this should be fast local NVMe, not NFS.
export DATA_ROOT="/raid/data/translatability"

# Parallelism for s5cmd / aws-cli / aria2c. The H100 node has plenty of cores;
# PhysioNet and TCIA will throttle well before you saturate them.
export DL_JOBS=16

# PhysioNet credentials, needed only for --restricted targets
# (EchoNext, Symile-MIMIC). Leave empty for the open datasets.
export PHYSIONET_USER=""
# Do not put the password here. The scripts call `wget --ask-password`,
# or you can export PHYSIONET_PASSWORD in an interactive shell only.

# Kaggle API token: place kaggle.json at ~/.kaggle/kaggle.json (chmod 600)
# and the CLI picks it up automatically. Needed only for --brats.
export KAGGLE_CONFIG_DIR="${HOME}/.kaggle"

# Synapse personal access token, needed only for the sequestered BraTS test set.
export SYNAPSE_AUTH_TOKEN=""
